[Unit]
Description=Kiwi Updater — auto-update system apps (and kiwi itself)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kiwi update --all --system --quiet
Nice=10
IOSchedulingClass=idle
# hardening (installers still need broad write access, so keep it light)
ProtectHome=read-only
PrivateTmp=true
