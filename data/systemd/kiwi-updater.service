[Unit]
Description=Kiwi Updater — auto-update user apps
# No After=network-online.target here: that is a system target and means
# nothing in the user manager, so it never did anything. Being offline is
# handled where it actually matters — an update that cannot reach a remote says
# so and leaves the recorded version alone, and the timer is Persistent.

[Service]
Type=oneshot
ExecStart=%h/.local/bin/kiwi update --all --user --quiet --notify
# A stuck run must not hold the scope lock indefinitely.
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle
