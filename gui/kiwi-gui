#!/usr/bin/env python3
"""kiwi-gui — starts Kiwi Apps, the desktop app of kiwi-updater.

The app is the Python package kiwi_apps: in a checkout it is in src/, an
install has it in ~/.local/share/kiwi-updater/lib/ (install.sh). This file
only finds it and runs it, so `kiwi-gui` works from both.
"""
import os
import runpy
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
for _d in (os.path.join(_here, "..", "src"), os.path.join(_data, "kiwi-updater", "lib")):
    if os.path.isfile(os.path.join(_d, "kiwi_apps", "__init__.py")):
        sys.path.insert(0, os.path.realpath(_d))
        break
else:
    sys.exit("kiwi-gui: Kiwi Apps is not installed completely (kiwi_apps is missing).\n"
             "Reinstall kiwi: kiwi self-update, or run get-kiwi.sh again.")

runpy.run_module("kiwi_apps.ui", run_name="__main__", alter_sys=True)
