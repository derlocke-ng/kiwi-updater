#!/usr/bin/env python3
"""kiwi-gui — browse, install and update apps from your kiwi catalogs.

An explorer, not a checklist. The list is expected to grow into hundreds of
small tools, so everything here is built around finding one: live search,
category and status filters, sorting, and a detail view per app showing its
screenshots, dependencies, and exactly what it installs.

All data comes from the CLI (`kiwi list --porcelain`, `kiwi info --porcelain`),
which stays the single source of truth. Images are read from the app's own
cloned repo, so nothing here fetches from the network.
"""
import os
import shlex
import shutil
import subprocess
import sys
import threading

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, Gio, GLib, GObject, Gdk, Pango  # noqa: E402

APP_ID = "eu.kiwinetwork.KiwiUpdater"

STATUS = {
    "installed":        ("Installed",       "ok"),
    "update-available": ("Update",          "upd"),
    "partial":          ("Partly installed", "warn"),
    "not-installed":    ("",                "dim"),
    "unreachable":      ("Unreachable",     "warn"),
}

# Icon themes disagree about what exists. Papirus, for one, ships almost none of
# the "*-symbolic" names that Adwaita does, so hard-coding them leaves every row
# showing the generic fallback glyph — which reads as "broken app", not "no
# icon". Each entry is a candidate list, best first, resolved against whatever
# theme is actually in use.
CATEGORY_ICON = {
    "security":    ["security-high-symbolic", "security-high",
                    "preferences-system-privacy", "changes-prevent"],
    "network":     ["network-wireless-symbolic", "network-wireless",
                    "network-workgroup", "network-transmit-receive"],
    "media":       ["applications-multimedia-symbolic", "applications-multimedia",
                    "multimedia-player"],
    "development": ["applications-engineering-symbolic", "applications-development",
                    "applications-engineering", "text-x-script"],
    "office":      ["text-editor-symbolic", "accessories-text-editor",
                    "text-editor", "applications-office"],
    "files":       ["folder-symbolic", "folder", "system-file-manager"],
    "desktop":     ["preferences-other-symbolic", "preferences-desktop",
                    "preferences-system", "applications-graphics"],
    "system":      ["system-software-install-symbolic", "system-software-install",
                    "applications-system", "system-run"],
}
COMPONENT_ICON = (
    ("gnome-extension", ["extension-symbolic", "application-x-addon",
                         "extension", "preferences-desktop-theme"]),
    ("daemon",          ["emblem-system-symbolic", "applications-system", "system-run"]),
    ("service",         ["emblem-system-symbolic", "applications-system", "system-run"]),
    ("gui",             ["application-x-executable-symbolic", "application-x-executable"]),
    ("cli",             ["utilities-terminal-symbolic", "utilities-terminal", "terminal"]),
)
FALLBACK_ICON = ["application-x-executable-symbolic", "application-x-executable",
                 "package-x-generic", "applications-other"]
TINTS = 6

_icon_cache = {}


def best_icon(candidates):
    """First candidate the running theme actually has."""
    key = tuple(candidates)
    if key in _icon_cache:
        return _icon_cache[key]
    display = Gdk.Display.get_default()
    theme = Gtk.IconTheme.get_for_display(display) if display else None
    chosen = candidates[-1]
    for name in candidates:
        if theme is None or theme.has_icon(name):
            chosen = name
            break
    _icon_cache[key] = chosen
    return chosen


def ui_icon(*candidates):
    """For chrome icons, where a missing glyph is merely ugly rather than wrong."""
    return best_icon(list(candidates) + ["image-missing"])

