# kiwi.manifest — app metadata for the kiwi updater (this file *is* the convention)
NAME=kiwi-updater
DESCRIPTION=Install and update open-source apps from git catalogs (CLI + GTK4 GUI)
VERSION=2.2.0
COMPONENTS=cli gui
CATEGORY=System
# from kiwi-icons (svg/classic/kiwi-updater.svg); install.sh installs the same
# file as the desktop icon under the app id
ICON=data/icons/eu.kiwinetwork.KiwiUpdater.svg
TAGS=updater installer catalog apps
SCOPES=user
HOMEPAGE=https://github.com/derlocke-ng/kiwi-updater
LICENSE=GPL-3.0-or-later
INSTALLER=install.sh
